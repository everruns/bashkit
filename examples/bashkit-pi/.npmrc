# Decision: match Dependabot's pnpm cooldown (`--config.minimumReleaseAge=4320`,
# i.e. 3 days) so a lockfile here can never pin a release younger than that
# cooldown. Dependabot re-resolves the whole tree on every version update, and
# pnpm *errors* with ERR_PNPM_NO_MATURE_MATCHING_VERSION rather than falling
# back to an older mature version, so a single freshly-published transitive dep
# fails the entire weekly run for the directory. That is what killed the
# 2026-08-19 `/crates/bashkit-js` run: `es-toolkit@1.51.0` was 2 days old and
# reached the tree through `@napi-rs/cli`, so `ava` never got its bump.
# Resolving under the same cooldown keeps locked versions mature by
# construction. Keep this value in sync with Dependabot's cooldown.
minimum-release-age=4320

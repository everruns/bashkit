      "cat << 'EOF' > /scripts/start.sh\n#!/usr/bin/env bash\nset -e\n\ncustom_db=false\nif [ -n \"${DB_HOST+x}\" ]; then\n    custom_db=true\nfi\n\nRESOLVED_DB_HOST=\"${DB_HOST:-localhost}\"\nRESOLVED_DB_PORT=\"${DB_PORT:-5432}\"\nRESOLVED_DB_NAME=\"${DB_NAME:-myapp}\"\nRESOLVED_LOG_LEVEL=\"${LOG_LEVEL:-info}\"\n\necho \"DB_HOST=$RESOLVED_DB_HOST\"\necho \"DB_PORT=$RESOLVED_DB_PORT\"\necho \"DB_NAME=$RESOLVED_DB_NAME\"\necho \"LOG_LEVEL=$RESOLVED_LOG_LEVEL\"\n\nif [ \"$custom_db\" = true ]; then\n    echo \"custom_db=true\"\nfi\nEOF\n\nchmod +x /scripts/start.sh",

[
  {"name":"quoted array", "script":"a=('one two' three); printf '<%s>\\n' \"${a[@]}\""},
  {"name":"sparse array", "script":"a=([2]=two [7]=seven); printf '%s\\n' \"${!a[@]}\" \"${#a[@]}\""},
  {"name":"array slice", "script":"a=(a b c d e); printf '%s\\n' \"${a[@]: -2}\""},
  {"name":"associative array", "script":"declare -A a=([key]='two words'); printf '%s\\n' \"${a[key]}\""},
  {"name":"nameref assignment", "script":"a=old; declare -n r=a; r=new; echo \"$a $r\""},
  {"name":"nameref array", "script":"a=(x y z); declare -n r=a; echo \"${r[1]} ${#r[@]}\""},
  {"name":"case conversion", "script":"a='hEllo World'; echo \"${a^^} ${a,,}\""},
  {"name":"pattern replacement", "script":"a=abcabc; echo \"${a//a/X} ${a#*b} ${a%%b*}\""},
  {"name":"indirect expansion", "script":"a=hello; r=a; echo \"${!r}\""},
  {"name":"dynamic scope", "script":"a=outer; g() { echo \"$a\"; }; f() { local a=inner; g; }; f; echo \"$a\""},
  {"name":"arithmetic array", "script":"a=(4 5); ((a[1]+=3)); echo \"${a[1]}\""},
  {"name":"brace sequence", "script":"printf '%s\\n' {03..09..3}"},
  {"name":"command substitution", "script":"a=$(printf 'x\\n\\n'); printf '<%s>\\n' \"$a\""},
  {"name":"subshell isolation", "script":"a=parent; (a=child; echo \"$a\"); echo \"$a\""},
  {"name":"process substitution", "script":"read -r a < <(echo hello); echo \"$a\""},
  {"name":"here string", "script":"read -r a b <<< 'one two'; echo \"$b $a\""},
  {"name":"pipefail", "script":"set -o pipefail; false | true; echo $?"},
  {"name":"errexit exception", "script":"set -e; false && echo no; echo yes"},
  {"name":"case fallthrough", "script":"case x in x) echo a ;;& y) echo no ;; *) echo b ;; esac"},
  {"name":"regex capture", "script":"[[ abc123 =~ ([a-z]+)([0-9]+) ]]; echo \"${BASH_REMATCH[1]} ${BASH_REMATCH[2]}\""},
  {"name":"mapfile", "script":"mapfile -t a <<< $'one\\ntwo'; printf '<%s>\\n' \"${a[@]}\""},
  {"name":"child shell", "script":"bash -c 'echo child'"},
  {"name":"read delimiter", "script":"IFS=: read -r a b <<< 'one:two'; echo \"$a/$b\""},
  {"name":"negative status", "script":"false"}
]

{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable", "ES2021.WeakRef"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "wrapper.ts",
    "scripted.ts",
    "internal.ts",
    "runtime-functions.ts",
    "langchain.ts",
    "anthropic.ts",
    "openai.ts",
    "ai.ts"
  ],
  "exclude": ["node_modules", "__test__"]
}
